{
  "name": "@simplify-erp/schematics",
  "version": "0.0.1",
  "description": "Schematics para geração de CRUDs do Simplify ERP",
  "private": true,
  "schematics": "./collection.json",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "npm run build && vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "peerDependencies": {
    "@angular-devkit/core": "^21.0.0",
    "@angular-devkit/schematics": "^21.0.0"
  }
}
