{
  "$schema": "http://json-schema.org/schema",
  "$id": "SimplifyErpForm",
  "title": "Gera o formulário de um recurso",
  "type": "object",
  "properties": {
    "module": {
      "type": "string",
      "description": "Módulo/feature de destino, em kebab-case (ex.: third-party).",
      "x-prompt": "Módulo (ex.: third-party)"
    },
    "name": {
      "type": "string",
      "description": "Recurso no singular, em kebab-case (ex.: partner-type).",
      "x-prompt": "Recurso no singular (ex.: partner-type)"
    },
    "fields": {
      "type": "string",
      "default": "",
      "description": "Campos separados por vírgula: nome[?]:tipo[:Rótulo][:extras]. Tipos: string, text, textarea, email, number, integer, decimal, currency, percent, boolean, date, datetime, enum, lookup.",
      "x-prompt": "Campos (ex.: name:string:Nome,active:boolean:Ativo; vazio = mínimo)"
    },
    "plural": {
      "type": "string",
      "default": "",
      "description": "Plural do recurso em kebab-case (sobrescreve a derivação automática).",
      "x-prompt": "Plural do recurso (kebab-case; vazio = automático)"
    },
    "label": {
      "type": "string",
      "default": "",
      "description": "Rótulo singular em pt-BR (ex.: Tipo de parceiro).",
      "x-prompt": "Rótulo singular (vazio = derivado)"
    },
    "detect-lookups": {
      "type": "boolean",
      "default": true,
      "description": "Trata campos terminados em _id como lookup automaticamente.",
      "x-prompt": "Tratar campos *_id como lookup automaticamente?"
    },
    "skip-lookup": {
      "type": "boolean",
      "default": false,
      "description": "Trata campos *_id como number (sem componente de lookup).",
      "x-prompt": "Tratar campos *_id como number (sem lookup)?"
    },
    "form-type": {
      "type": "string",
      "enum": ["dialog", "page"],
      "default": "dialog",
      "description": "Formato do formulário.",
      "x-prompt": {
        "message": "Formato do formulário:",
        "type": "list",
        "items": [
          { "value": "dialog", "label": "Dialog (modal)" },
          { "value": "page", "label": "Página" }
        ]
      }
    },
    "skip-tests": {
      "type": "boolean",
      "default": false,
      "description": "Não gera arquivos de teste.",
      "x-prompt": "Pular arquivos de teste?"
    },
    "force": {
      "type": "boolean",
      "default": false,
      "description": "Sobrescreve arquivos existentes.",
      "x-prompt": "Sobrescrever arquivos existentes?"
    }
  },
  "required": ["module", "name"]
}
