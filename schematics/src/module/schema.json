{
  "$schema": "http://json-schema.org/schema",
  "$id": "SimplifyErpModule",
  "title": "Cria a estrutura base de um módulo (feature)",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Módulo/feature em kebab-case (ex.: catalog).",
      "x-prompt": "Módulo/feature em kebab-case (ex.: catalog)"
    },
    "moduleLabel": {
      "type": "string",
      "description": "Rótulo do grupo de menu do módulo (ex.: Catálogo).",
      "x-prompt": "Rótulo do grupo de menu (ex.: Catálogo)"
    },
    "module-label": {
      "type": "string",
      "description": "Alias of --moduleLabel for programmatic calls."
    },
    "menuIcon": {
      "type": "string",
      "description": "Ícone PrimeIcons do grupo de menu (ex.: pi pi-folder).",
      "x-prompt": "Ícone PrimeIcons do grupo de menu (ex.: pi pi-folder)"
    },
    "menu-icon": {
      "type": "string",
      "description": "Alias of --menuIcon for programmatic calls."
    },
    "skipMenu": {
      "type": "boolean",
      "description": "Não adiciona o grupo de menu do módulo."
    },
    "skip-menu": {
      "type": "boolean",
      "description": "Alias of --skipMenu for programmatic calls."
    },
    "skipRoutes": {
      "type": "boolean",
      "description": "Não registra o módulo no app.routes.ts."
    },
    "skip-routes": {
      "type": "boolean",
      "description": "Alias of --skipRoutes for programmatic calls."
    },
    "force": {
      "type": "boolean",
      "default": false,
      "description": "Sobrescreve arquivos existentes.",
      "x-prompt": "Sobrescrever arquivos existentes?"
    }
  },
  "required": [
    "name"
  ]
}
