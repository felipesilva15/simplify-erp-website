{
  "$schema": "http://json-schema.org/schema",
  "$id": "SimplifyErpRoutes",
  "title": "Gera e registra as rotas de um recurso",
  "type": "object",
  "properties": {
    "module": {
      "type": "string",
      "description": "Módulo/feature de destino, em kebab-case (ex.: third-party).",
      "x-prompt": "Módulo (ex.: third-party)"
    },
    "name": {
      "type": "string",
      "description": "Recurso no singular, em kebab-case (ex.: partner-type).",
      "x-prompt": "Recurso no singular (ex.: partner-type)"
    },
    "plural": {
      "type": "string",
      "default": "",
      "description": "Plural do recurso em kebab-case (sobrescreve a derivação automática).",
      "x-prompt": "Plural do recurso (kebab-case; vazio = automático)"
    },
    "label": {
      "type": "string",
      "default": "",
      "description": "Rótulo singular em pt-BR (ex.: Tipo de parceiro).",
      "x-prompt": "Rótulo singular (vazio = derivado)"
    },
    "permission-key": {
      "type": "string",
      "default": "",
      "description": "Chave base de permissão (ex.: partnerTypes).",
      "x-prompt": "Chave base de permissão (vazio = derivado)"
    },
    "form-type": {
      "type": "string",
      "enum": ["dialog", "page"],
      "default": "dialog",
      "description": "Formato do formulário associado às rotas.",
      "x-prompt": {
        "message": "Formato do formulário associado:",
        "type": "list",
        "items": [
          { "value": "dialog", "label": "Dialog (modal)" },
          { "value": "page", "label": "Página" }
        ]
      }
    },
    "force": {
      "type": "boolean",
      "default": false,
      "description": "Sobrescreve arquivos existentes.",
      "x-prompt": "Sobrescrever arquivos existentes?"
    }
  },
  "required": ["module", "name"]
}
