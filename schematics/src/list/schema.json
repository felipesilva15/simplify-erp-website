{
  "$schema": "http://json-schema.org/schema",
  "$id": "SimplifyErpList",
  "title": "Gera a página de listagem de um recurso",
  "type": "object",
  "properties": {
    "module": {
      "type": "string",
      "description": "Módulo/feature de destino, em kebab-case (ex.: third-party).",
      "x-prompt": "Módulo (ex.: third-party)"
    },
    "name": {
      "type": "string",
      "description": "Recurso no singular, em kebab-case (ex.: partner-type).",
      "x-prompt": "Recurso no singular (ex.: partner-type)"
    },
    "fields": {
      "type": "string",
      "default": "",
      "description": "Campos separados por vírgula: nome[?]:tipo[:Rótulo][:extras]. Campos terminados em _id viram lookup.",
      "x-prompt": "Campos (ex.: name:string:Nome,active:boolean:Ativo; vazio = mínimo)"
    },
    "plural": {
      "type": "string",
      "default": "",
      "description": "Plural do recurso em kebab-case (sobrescreve a derivação automática).",
      "x-prompt": "Plural do recurso (kebab-case; vazio = automático)"
    },
    "label": {
      "type": "string",
      "default": "",
      "description": "Rótulo singular em pt-BR (ex.: Tipo de parceiro).",
      "x-prompt": "Rótulo singular (vazio = derivado)"
    },
    "labelPlural": {
      "type": "string",
      "description": "Rótulo plural em pt-BR (ex.: Tipos de parceiro).",
      "x-prompt": "Rótulo plural (vazio = derivado)"
    },
    "label-plural": {
      "type": "string",
      "description": "Alias of --labelPlural for programmatic calls."
    },
    "moduleLabel": {
      "type": "string",
      "description": "Rótulo do módulo usado no breadcrumb (ex.: Terceiro).",
      "x-prompt": "Rótulo do módulo (vazio = derivado)"
    },
    "module-label": {
      "type": "string",
      "description": "Alias of --moduleLabel for programmatic calls."
    },
    "permissionKey": {
      "type": "string",
      "description": "Chave base de permissão (ex.: partnerTypes).",
      "x-prompt": "Chave base de permissão (vazio = derivado)"
    },
    "permission-key": {
      "type": "string",
      "description": "Alias of --permissionKey for programmatic calls."
    },
    "placeholder": {
      "type": "string",
      "default": "",
      "description": "Texto do placeholder de busca (vazio = derivado dos campos de texto).",
      "x-prompt": "Placeholder de busca (vazio = derivado dos campos de texto)"
    },
    "detectLookups": {
      "type": "boolean",
      "description": "Trata campos terminados em _id como lookup automaticamente.",
      "x-prompt": "Tratar campos *_id como lookup automaticamente?"
    },
    "detect-lookups": {
      "type": "boolean",
      "description": "Alias of --detectLookups for programmatic calls."
    },
    "formType": {
      "type": "string",
      "enum": [
        "dialog",
        "page"
      ],
      "description": "Formato do formulário associado (define o uso de <router-outlet>).",
      "x-prompt": {
        "message": "Formato do formulário associado:",
        "type": "list",
        "items": [
          {
            "value": "dialog",
            "label": "Dialog (modal)"
          },
          {
            "value": "page",
            "label": "Página"
          }
        ]
      }
    },
    "form-type": {
      "type": "string",
      "description": "Alias of --formType for programmatic calls."
    },
    "tableType": {
      "type": "string",
      "enum": [
        "table",
        "tree"
      ],
      "description": "Tipo da listagem: 'table' (tabela convencional) ou 'tree' (árvore hierárquica).",
      "x-prompt": {
        "message": "Tipo da listagem:",
        "type": "list",
        "items": [
          {
            "value": "table",
            "label": "Tabela convencional"
          },
          {
            "value": "tree",
            "label": "Tree view (árvore)"
          }
        ]
      }
    },
    "table-type": {
      "type": "string",
      "description": "Alias of --tableType for programmatic calls."
    },
    "treeParentField": {
      "type": "string",
      "description": "Campo pai usado por --table-type=tree (padrão: campo *_id com prefixo 'parent', senão 'parent_id')."
    },
    "tree-parent-field": {
      "type": "string",
      "description": "Alias of --treeParentField for programmatic calls."
    },
    "treeLabelField": {
      "type": "string",
      "description": "Campo usado como rótulo do nó em --table-type=tree (padrão: 'name' ou o primeiro campo de texto)."
    },
    "tree-label-field": {
      "type": "string",
      "description": "Alias of --treeLabelField for programmatic calls."
    },
    "withExport": {
      "type": "boolean",
      "description": "Inclui as opções de exportação na listagem.",
      "x-prompt": "Incluir opções de exportação?"
    },
    "with-export": {
      "type": "boolean",
      "description": "Alias of --withExport for programmatic calls."
    },
    "skipLookup": {
      "type": "boolean",
      "description": "Trata campos *_id como number (sem componente de lookup)."
    },
    "skip-lookup": {
      "type": "boolean",
      "description": "Alias of --skipLookup for programmatic calls."
    },
    "skipTests": {
      "type": "boolean",
      "description": "Não gera arquivos de teste."
    },
    "skip-tests": {
      "type": "boolean",
      "description": "Alias of --skipTests for programmatic calls."
    },
    "force": {
      "type": "boolean",
      "default": false,
      "description": "Sobrescreve arquivos existentes.",
      "x-prompt": "Sobrescrever arquivos existentes?"
    }
  },
  "required": [
    "module",
    "name"
  ]
}
