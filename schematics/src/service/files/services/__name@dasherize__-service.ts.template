import { HttpClient, HttpParams } from '@angular/common/http';
import { inject, Injectable } from '@angular/core';
import { Observable } from 'rxjs';
import { environment } from '<%= toAppDeep %>environments/environment';
import { CrudService } from '<%= toApp %>core/contracts/crud-service';
import { ExportableService } from '<%= toApp %>core/contracts/exportable-service';
import { LookupService } from '<%= toApp %>core/contracts/lookup-service';
import { ApiResponse } from '<%= toApp %>core/models/api-response';
import { ExportRequestParams } from '<%= toApp %>core/models/export-request-params';
import { ListRequestParams } from '<%= toApp %>core/models/list-request-params';
import { LookupFilter } from '<%= toApp %>core/models/lookup-filter';
import { LookupItem } from '<%= toApp %>core/models/lookup-item';
import { HttpQueryBuilderService } from '<%= toApp %>core/services/http-query-builder-service';
import { <%= className %> } from '../models/<%= name %>';

@Injectable({
  providedIn: 'root',
})
export class <%= serviceClass %> implements CrudService<<%= className %>>, LookupService, ExportableService {
  private readonly baseUrl: string = environment.baseUrlApi + '/<%= module %>/<%= resource %>';

  private http: HttpClient = inject(HttpClient)
  private queryBuilder: HttpQueryBuilderService = inject(HttpQueryBuilderService)

  list(params?: ListRequestParams): Observable<ApiResponse<<%= className %>[]>> {
    const httpParams: HttpParams = this.queryBuilder.buildHttpParams(params);
    return this.http.get<ApiResponse<<%= className %>[]>>(`${this.baseUrl}`, { withCredentials: true, params: httpParams });
  }

  get(id: number): Observable<ApiResponse<<%= className %>>> {
    return this.http.get<ApiResponse<<%= className %>>>(`${this.baseUrl}/${id}`, { withCredentials: true });
  }

  edit(id: number): Observable<ApiResponse<<%= className %>>> {
    return this.http.get<ApiResponse<<%= className %>>>(`${this.baseUrl}/${id}/edit`, { withCredentials: true });
  }

  create(payload: Partial<<%= className %>>): Observable<ApiResponse<<%= className %>>> {
    return this.http.post<ApiResponse<<%= className %>>>(`${this.baseUrl}`, payload, { withCredentials: true });
  }

  update(id: number, payload: Partial<<%= className %>>): Observable<ApiResponse<<%= className %>>> {
    return this.http.put<ApiResponse<<%= className %>>>(`${this.baseUrl}/${id}`, payload, { withCredentials: true });
  }

  delete(id: number): Observable<void> {
    return this.http.delete<void>(`${this.baseUrl}/${id}`, { withCredentials: true });
  }

  search(params: LookupFilter): Observable<ApiResponse<LookupItem[]>> | Promise<ApiResponse<LookupItem[]>> {
    const httpParams: HttpParams = this.queryBuilder.buildHttpParams(params);
    return this.http.get<ApiResponse<LookupItem[]>>(`${this.baseUrl}/lookup`, { withCredentials: true, params: httpParams });
  }

  export(params: ExportRequestParams): Observable<Blob> {
    const httpParams: HttpParams = this.queryBuilder.buildHttpParams(params);
    return this.http.get(`${this.baseUrl}/export`, { withCredentials: true, params: httpParams, responseType: 'blob' });
  }
}
