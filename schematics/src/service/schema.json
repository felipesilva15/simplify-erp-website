{
  "$schema": "http://json-schema.org/schema",
  "$id": "SimplifyErpService",
  "title": "Gera o service de um recurso",
  "type": "object",
  "properties": {
    "module": {
      "type": "string",
      "description": "Módulo/feature de destino, em kebab-case (ex.: third-party).",
      "x-prompt": "Módulo (ex.: third-party)"
    },
    "name": {
      "type": "string",
      "description": "Recurso no singular, em kebab-case (ex.: partner-type).",
      "x-prompt": "Recurso no singular (ex.: partner-type)"
    },
    "plural": {
      "type": "string",
      "description": "Plural do recurso em kebab-case (sobrescreve a derivação automática)."
    },
    "skip-tests": {
      "type": "boolean",
      "default": false,
      "description": "Não gera arquivos de teste."
    },
    "force": {
      "type": "boolean",
      "default": false,
      "description": "Sobrescreve arquivos existentes."
    }
  },
  "required": ["module", "name"]
}
