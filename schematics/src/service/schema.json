{
  "$schema": "http://json-schema.org/schema",
  "$id": "SimplifyErpService",
  "title": "Gera o service de um recurso",
  "type": "object",
  "properties": {
    "module": {
      "type": "string",
      "description": "Módulo/feature de destino, em kebab-case (ex.: third-party).",
      "x-prompt": "Módulo (ex.: third-party)"
    },
    "name": {
      "type": "string",
      "description": "Recurso no singular, em kebab-case (ex.: partner-type).",
      "x-prompt": "Recurso no singular (ex.: partner-type)"
    },
    "plural": {
      "type": "string",
      "default": "",
      "description": "Plural do recurso em kebab-case (sobrescreve a derivação automática).",
      "x-prompt": "Plural do recurso (kebab-case; vazio = automático)"
    },
    "with-export": {
      "type": "boolean",
      "default": false,
      "description": "Implementa ExportableService (método export) no service.",
      "x-prompt": "Implementar exportação (ExportableService)?"
    },
    "with-log": {
      "type": "boolean",
      "default": false,
      "description": "Implementa LogableService (método activityLogs) no service.",
      "x-prompt": "Implementar LogableService (activityLogs)?"
    },
    "skip-lookup": {
      "type": "boolean",
      "default": false,
      "description": "Não implementa LookupService (método search) no service."
    },
    "skip-tests": {
      "type": "boolean",
      "default": false,
      "description": "Não gera arquivos de teste."
    },
    "force": {
      "type": "boolean",
      "default": false,
      "description": "Sobrescreve arquivos existentes.",
      "x-prompt": "Sobrescrever arquivos existentes?"
    }
  },
  "required": ["module", "name"]
}
